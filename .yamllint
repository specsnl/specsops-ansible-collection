---
extends: default
rules:
  line-length:
    max: 160
  indentation:
    spaces: 2
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
ignore: |
  Taskfile.yml
  Taskfile.*.yml
  compose.yml
  compose.*.yml
  changelogs/changelog.yaml
  collections/
